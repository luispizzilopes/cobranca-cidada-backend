{
  "AllowedHosts": "*",
  "ApiSettings": {
    "Title": "Cobrança Cidadã API",
    "Version": "1.0",
    "Description": "Cobrança Cidadã API"
  },
  "Swagger": {
    "Username": "swagger"
  },
  "Jwt": {
    "key": "CHANGE_ME_SECRET_KEY_MIN_32_CHARS_COBRANCA"
  },
  "TokenConfiguration": {
    "Issuer": "cobranca-cidada-api",
    "Audience": "cobranca-cidada-clients",
    "AccessTokenExpireMinutes": "60",
    "VoterTokenExpireDays": "30",
    "RefreshTokenExpireDays": "30"
  },
  "Voting": {
    "EmailHmacKey": "CHANGE_ME_VOTER_HMAC_KEY_MIN_32_CHARS_COBRANCA",
    "MinimumPublicVotes": 20,
    "Burst": {
      "VoterMaxActions": 10,
      "VoterWindowSeconds": 10,
      "VoterBlockSeconds": 300,
      "IpMaxActions": 15,
      "IpWindowSeconds": 10,
      "IpBlockSeconds": 300,
      "IpMaxDistinctVoters": 10,
      "IpDistinctWindowSeconds": 600,
      "IpDistinctBlockSeconds": 1800,
      "CommitmentSpikeMaxActions": 100,
      "CommitmentSpikeWindowSeconds": 300,
      "CommitmentSpikeAlertSeconds": 3600
    }
  },
  "RateLimits": {
    "PublicRead": 120,
    "AuthAnonymous": 30,
    "EmailCode": 10,
    "Vote": 60
  },
  "Seo": {
    "SiteUrl": "http://localhost:5173"
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "BrevoSettings": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
